# SafeHer server
SAFEHER_HOST=127.0.0.1
SAFEHER_PORT=8000
SAFEHER_SOS_PROVIDER=auto

# Email-only auth is handled locally by the Python backend.
# No OTP, SMS, or SMTP provider configuration is required.

# Google Sign-In for the SafeHer app-style landing page.
# Use the Web client ID from Google Cloud OAuth credentials.
SAFEHER_GOOGLE_CLIENT_ID=

# Fast2SMS automatic SOS delivery.
# Add your Fast2SMS API key to enable direct SMS sending from the backend.
# Default route "q" uses Quick SMS. If you switch to "dlt_manual", also fill
# sender/entity/template details below with your approved DLT values.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_LANGUAGE=english
FAST2SMS_TIMEOUT=15
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_TEMPLATE_ID=

# Optional: automatic SOS webhook integration.
# Point this to your SMS/WhatsApp relay endpoint so SOS messages are sent
# automatically by the backend without opening WhatsApp in the browser.
# If both webhook and Fast2SMS are configured, Fast2SMS will be used when
# SAFEHER_SOS_PROVIDER=auto and FAST2SMS_API_KEY is present.
SAFEHER_SOS_WEBHOOK_URL=
SAFEHER_SOS_WEBHOOK_BEARER_TOKEN=
SAFEHER_SOS_WEBHOOK_TIMEOUT=15

# Public URL used inside incident viewer links sent to contacts.
# Set this to your public tunnel or hosted domain so other devices can open it.
SAFEHER_PUBLIC_BASE_URL=

# Free audio-room links sent with SOS alerts.
# The default public Jitsi base works without payment or signup.
SAFEHER_AUDIO_ROOM_BASE_URL=https://meet.jit.si

# Email alert delivery.
SAFEHER_SMTP_HOST=
SAFEHER_SMTP_PORT=587
SAFEHER_SMTP_USERNAME=
SAFEHER_SMTP_PASSWORD=
SAFEHER_SMTP_FROM=
SAFEHER_SMTP_USE_TLS=true
SAFEHER_SMTP_USE_SSL=false

# Telegram bot alert delivery.
# The bot can only message chats that have already started the bot or allowed it.
SAFEHER_TELEGRAM_BOT_TOKEN=
SAFEHER_TELEGRAM_VOICE_ALERTS=true

# Automatic voice call delivery for SOS contacts.
# Choose "auto" to prefer Twilio when configured, otherwise fall back to a call webhook.
SAFEHER_CALL_PROVIDER=auto
SAFEHER_CALL_WEBHOOK_URL=
SAFEHER_CALL_WEBHOOK_BEARER_TOKEN=
SAFEHER_CALL_WEBHOOK_TIMEOUT=20

# Twilio voice call delivery.
# TWILIO_CALL_FROM must be a Twilio-verified outgoing number in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALL_FROM=
TWILIO_CALL_VOICE=alice
TWILIO_CALL_LANGUAGE=en-US
TWILIO_CALL_TIMEOUT=20
